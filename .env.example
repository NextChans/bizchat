# 브릿지 세션 쿠키 암호화 키 (32자 이상). 운영 필수, 로컬은 미설정 시 개발용 키 사용
BRIDGE_SESSION_SECRET=

# 파트너(캐시노트) 서명 검증용 공유 비밀키. 운영 필수
CASHNOTE_PARTNER_SECRET=

# 로컬/개발에서만 off 허용. 운영(NODE_ENV=production)은 항상 서명 검증
BRIDGE_SIGNATURE_MODE=enforce

# Vercel Preview 에서 /dev/partner 목업 파트너 페이지를 켤 때만 true (Production 에서는 무시)
BRIDGE_DEV_TOOLS=false


# 결제 (FirstPay v3). develop=dev.firstpay.co.kr / product=pay.firstpay.co.kr. 환경끼리 섞으면 9003·9010
KPN_ENV=develop
# 공개 테스트 계정(배포 샘플에 포함된 값). 운영 MID·PASSKEY 는 배포 환경변수에만
KPN_MX_ID=testcorp
KPN_PASSKEY=6aMoJujE34XnL9gvUqdKGMqs9GzYaNo6
# returnUrl 의 기준 주소. 결제서버가 접근할 수 있는 공개 주소여야 한다
APP_BASE_URL=http://localhost:3000
# 파트너 앱 웹뷰 복귀 스킴(예: cashnote://). 간편결제 앱 복귀에 사용. 미정이면 비움
PARTNER_APP_SCHEME=

# 비즈챗 서버 간 API. 비우면 목업 클라이언트(MockBizchatClient)
BIZCHAT_API_BASE_URL=
BIZCHAT_API_KEY=
# 비즈챗 목업 발송 응답: (비움)=정상 / reject=접수 거절→결제 망취소 / timeout=무응답→재확인
BIZCHAT_MOCK_SEND=
